{
	"name": "frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently -k -n wrangler,vite -c blue,green \"npm:dev:wrangler\" \"npm:dev:vite\"",
		"dev:vite": "VITE_API_PROXY_TARGET=http://127.0.0.1:18312 vite --host",
		"dev:wrangler": "wrangler dev --config wrangler.jsonc --port 18312 --ip 0.0.0.0",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "npm run build && vite preview",
		"deploy": "npm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"test:unit": "cucumber-js --config test/cucumber.cjs --profile unit",
		"test:integration": "cucumber-js --config test/cucumber.cjs --profile integration",
		"test:e2e": "cucumber-js --config test/cucumber.cjs --profile e2e",
		"test": "npm run test:unit && npm run test:integration && npm run test:e2e"
	},
	"dependencies": {
		"postgres": "^3.4.7",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"react-router-dom": "^6.30.4",
		"zustand": "^4.5.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.13.15",
		"@cucumber/cucumber": "^12.7.0",
		"@eslint/js": "^9.33.0",
		"@types/chai": "^5.2.3",
		"@types/react": "^19.1.10",
		"@types/react-dom": "^19.1.7",
		"@vitejs/plugin-react-swc": "^4.0.0",
		"chai": "^6.2.2",
		"concurrently": "^9.1.2",
		"eslint": "^9.33.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"globals": "^16.3.0",
		"puppeteer": "^24.40.0",
		"rollup": "^4.59.0",
		"tsx": "^4.21.0",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.39.1",
		"vite": "^7.1.2",
		"wrangler": "^4.45.0"
	},
	"overrides": {
		"ip-address": "10.4.0",
		"undici": "7.29.0",
		"sharp": "0.35.0"
	}
}
